# Copy to .env. Every key is optional unless noted. Never commit .env.

# --- identity (weather.gov REJECTS requests without a descriptive User-Agent) ---
NYC_LIVE_USER_AGENT="nyc-live/0.1 (https://github.com/arinze-okigbo/nyc-live; you@example.com)"

# --- storage ---
NYC_LIVE_DATA_DIR=./data
NYC_LIVE_DUCKDB_PATH=./data/nyc_live.duckdb

# --- optional keys: raise rate limits / unlock deferred feeds ---
# python-dotenv does not strip inline "# ..." comments from unquoted values, so an
# empty key must have nothing at all after "=" on its line, not a trailing comment.
# SOCRATA_APP_TOKEN: optional; only raises data.cityofnewyork.us rate limits
SOCRATA_APP_TOKEN=
# MTA_BUS_TIME_API_KEY: deferred feed; adapter is skipped when empty
MTA_BUS_TIME_API_KEY=
# NY511_API_KEY: deferred feed; adapter is skipped when empty
NY511_API_KEY=

# --- tests ---
# set to 1 to run tests marked "live" against real upstreams
NYC_LIVE_TESTS=0
